generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique
  userId       String
  expires      DateTime
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User Model ─────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed – null for OAuth-only users
  role          String    @default("AGENT") // ADMIN | AGENT | CLIENT | SCHOOL
  // Agent onboarding lifecycle: INCOMPLETE -> PENDING_REVIEW -> ACTIVE (or SUSPENDED).
  // Defaults to ACTIVE so pre-existing accounts keep working; new self-service agents are created INCOMPLETE.
  agentStatus        String    @default("ACTIVE")
  whatsapp           String?
  serviceAreas       String?   // JSON array of neighbourhoods/cities served
  termsAcceptedAt    DateTime?
  profileCompletedAt DateTime?
  agentReviewedAt    DateTime?
  phone         String?
  company       String?   // agency name
  license       String?   // real estate license number
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  properties          Property[]
  receivedMessages    Message[]  @relation("AgentMessages")
  visits              Visit[]
  agentConversations  Conversation[] @relation("AgentConversations")
  sentMessages        Message[]  @relation("MessageSenders")
  clientConversations Conversation[] @relation("ClientConversations")
  school              School?        @relation("SchoolOwner")
  schoolReviews       SchoolReview[]
}

// ─── Property Model ─────────────────────────────────────────
model Property {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  price       Float
  currency    String   @default("GHC")
  location    String   // e.g. "East Legon, Accra"
  city        String   @default("Accra")
  region      String   @default("Greater Accra")
  country     String   @default("Ghana")
  type        String   // APARTMENT | HOUSE | VILLA | LAND | COMMERCIAL | OFFICE | HOTEL | HOSTEL
  status      String   @default("AVAILABLE") // AVAILABLE | SOLD | RENTED | RESERVED
  listingType   String   @default("SALE") // SALE | RENT
  priceDuration String   @default("MONTH") // DAY | MONTH | YEAR — for rental price duration
  bedrooms      Int?
  bathrooms   Int?
  area        Float?   // square meters
  furnished   Boolean  @default(false)
  parking     Boolean  @default(false)
  pool        Boolean  @default(false)
  gym         Boolean  @default(false)
  images      String   @default("[]") // JSON array of image URLs
  videos      String   @default("[]") // JSON array of video URLs
  featured    Boolean  @default(false)
  views       Int      @default(0)
  agentId     String
  agent       User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages       Message[]
  visits         Visit[]
  conversations  Conversation[]

  @@index([status, country, city])
}

// ─── Conversation Model (social-network style) ──────────────
// One conversation per (visitor, agent, property) — reusing if visitor re-inquires.
model Conversation {
  id                String    @id @default(cuid())
  propertyId        String?
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agentId           String
  agent             User      @relation("AgentConversations", fields: [agentId], references: [id], onDelete: Cascade)

  // Registered client who owns this conversation (null while the visitor is still a guest)
  clientId          String?
  client            User?     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: SetNull)
  guestIpHash       String?   // hashed IP of the guest who started it (anti-spam rate limiting)

  // Visitor info (legacy magic-link visitors and guests; mirrored from the client once claimed)
  visitorName       String
  visitorEmail      String
  visitorPhone      String?
  visitorToken      String    @unique  // magic link token

  subject           String
  lastMessageAt     DateTime  @default(now())
  unreadForAgent    Int       @default(0)
  unreadForVisitor  Int       @default(0)
  closed            Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages          Message[]

  @@index([clientId, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@index([guestIpHash, createdAt])
}

// ─── Email one-time codes (passwordless sign-in for clients) ─
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    // HMAC-SHA256 of the code, never the code itself
  ipHash     String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

// ─── Message Model ──────────────────────────────────────────
model Message {
  id              String   @id @default(cuid())

  // New conversation-based fields (nullable for legacy messages)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType      String   @default("VISITOR") // VISITOR | AGENT | ADMIN
  senderUserId    String?  // agent/admin user id when applicable
  senderUser      User?    @relation("MessageSenders", fields: [senderUserId], references: [id], onDelete: SetNull)
  body            String

  // Legacy fields kept for backward compat with old /api/messages and existing rows
  senderName      String   @default("")
  senderEmail     String   @default("")
  senderPhone     String?
  subject         String   @default("")
  isRead          Boolean  @default(false)

  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agentId         String?
  agent           User?     @relation("AgentMessages", fields: [agentId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Visit Model ────────────────────────────────────────────
model Visit {
  id          String   @id @default(cuid())
  visitorName String
  visitorEmail String
  visitorPhone String
  visitDate   DateTime
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  notes       String?
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId     String
  agent       User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Language schools (English in Ghana, French in Ghana & francophone Africa) ───
model School {
  id             String    @id @default(cuid())
  ownerId        String    @unique
  owner          User      @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name           String
  slug           String    @unique
  tagline        String?
  description    String
  teachesEnglish Boolean   @default(false)
  teachesFrench  Boolean   @default(false)
  levels         String    @default("[]") // JSON: BEGINNER | INTERMEDIATE | ADVANCED
  formats        String    @default("[]") // JSON: IN_PERSON | ONLINE | INTENSIVE | PRIVATE | EVENING | KIDS
  exams          String    @default("[]") // JSON: IELTS | TOEFL | TOEIC | CAMBRIDGE | DELF | DALF | TCF | TEF

  country        String    // ISO code: GH | CI | TG | BJ | SN | BF
  city           String
  address        String?
  phone          String?
  whatsapp       String?
  email          String?
  website        String?
  logo           String?
  coverImage     String?
  accreditation  String?
  priceFrom      Float?
  currency       String    @default("GHS")
  priceUnit      String    @default("MONTH") // HOUR | WEEK | MONTH | COURSE

  status         String    @default("PENDING_REVIEW") // PENDING_REVIEW | ACTIVE | SUSPENDED
  featured       Boolean   @default(false)
  reviewedAt     DateTime?
  // Denormalised from visible reviews, recomputed on every review change
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reviews        SchoolReview[]

  @@index([status, country, city])
  @@index([status, ratingAvg])
}

model SchoolReview {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int       // 1..5
  title     String?
  comment   String
  hidden    Boolean   @default(false) // moderated by an admin
  reply     String?   // public answer from the school
  repliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([schoolId, authorId]) // one review per client and school
  @@index([schoolId, hidden, createdAt])
}
